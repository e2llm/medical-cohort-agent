# ─── Elasticsearch / Kibana ───────────────────────────
ELASTIC_VERSION=9.3.0
ELASTIC_PASSWORD=changeme        # REQUIRED: set a strong password
KIBANA_PASSWORD=changeme         # REQUIRED: set a strong password
ES_PORT=9200
KIBANA_PORT=5601

# ─── LLM Connector (pick one) ────────────────────────
# Option A: Cloud AI (easiest — just set your API key)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Option B: Local Ollama (air-gapped, requires GPU or LAN Ollama host)
# Uncomment and set URL/model. Model must support tool calling (see docs/LLM-TOOL-CALLING.md).
# OLLAMA_LLM_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen3:30b

# ─── Embeddings (E5 via Ollama — runs fine on CPU) ───
# OLLAMA_URL is used by ES (container-to-container). OLLAMA_HOST_URL by host scripts.
OLLAMA_URL=http://ollama:11434
OLLAMA_HOST_URL=http://localhost:11434
EMBED_MODEL=qllama/multilingual-e5-large

# ─── Generator ────────────────────────────────────────
NUM_PATIENTS=500
SEED=42
